#!/bin/bash
# First line: "<cpu_pct> <mem_pct> <load1> <load5> <load15> <freq_mhz>
# <mem_total_kb> <mem_avail_kb> <swap_total_kb> <swap_free_kb>", using a
# short /proc/stat sample window for cpu_pct. Everything else there is a
# single read of a file the kernel already maintains -- no lm-sensors or
# other extra package, which is why there's no temperature: that needs a
# sensor that isn't guaranteed to exist or to be the CPU package on every
# machine. Self-contained (no dependency on the separate sysmon plugin) so
# the notch still works if that plugin is ever disabled or removed.
#
# Then up to 4 more lines, "<name>\t<pct>", the top CPU-consuming
# processes (by the same /proc/stat-window sampling as cpu_pct, so their
# percentages are on the same scale and sum close to cpu_pct) followed by
# one "__OTHER__\t<pct>" line for everything not in the top 3. <name> is
# the kernel's own truncated comm (max 15 chars) -- there's no lookup
# table for prettier names the way macOS's Activity Monitor has one.

# /proc/<pid>/stat's 2nd field is "(comm)" and comm itself can contain
# spaces or even parens, so position-based field splitting doesn't work
# directly -- this splits on ")" and keeps only the LAST piece, which is
# always what comes after comm regardless of what's inside it. From
# there, state is that piece's field 1, so utime/stime (originally
# fields 14/15) land at 12/13.
proc_snapshot() {
  awk '
  {
    n = split($0, a, ")")
    rest = a[n]
    head = substr($0, 1, length($0) - length(rest) - 1)
    paren = index(head, "(")
    comm = substr(head, paren + 1)
    split(rest, f, " ")
    split(FILENAME, pp, "/")
    print pp[3] "\t" comm "\t" (f[12] + f[13] + 0)
  }' /proc/[0-9]*/stat 2>/dev/null
}

sample_dir=$(mktemp -d)
trap 'rm -rf "$sample_dir"' EXIT

proc_snapshot > "$sample_dir/p1"
read -r _ u1 n1 s1 i1 w1 irq1 sirq1 st1 _ < /proc/stat
sleep 0.3
read -r _ u2 n2 s2 i2 w2 irq2 sirq2 st2 _ < /proc/stat
proc_snapshot > "$sample_dir/p2"

idle1=$((i1 + w1))
idle2=$((i2 + w2))
total1=$((u1 + n1 + s1 + i1 + w1 + irq1 + sirq1 + st1))
total2=$((u2 + n2 + s2 + i2 + w2 + irq2 + sirq2 + st2))
totald=$((total2 - total1))
idled=$((idle2 - idle1))

cpu=0
if (( totald > 0 )); then
  cpu=$(( (100 * (totald - idled)) / totald ))
fi

mem_total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
mem_avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)
swap_total=$(awk '/^SwapTotal:/{print $2}' /proc/meminfo)
swap_free=$(awk '/^SwapFree:/{print $2}' /proc/meminfo)
mem=0
if (( mem_total > 0 )); then
  mem=$(( (100 * (mem_total - mem_avail)) / mem_total ))
fi

read -r load1 load5 load15 _ < /proc/loadavg

freq_khz=""
if [[ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq ]]; then
  freq_khz=$(< /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq)
fi
if [[ -n "$freq_khz" ]]; then
  freq_mhz=$(( freq_khz / 1000 ))
else
  # Some VMs/kernels have no cpufreq sysfs at all; /proc/cpuinfo's
  # "cpu MHz" is the fallback, less precise but always present.
  freq_mhz=$(awk '/^cpu MHz/{print int($4); exit}' /proc/cpuinfo)
fi

echo "$cpu $mem $load1 $load5 $load15 ${freq_mhz:-0} ${mem_total:-0} ${mem_avail:-0} ${swap_total:-0} ${swap_free:-0}"

# Per-process delta, normalized against the SAME totald as cpu_pct above
# (not against a single core) -- that's what makes top3 + "everything
# else" sum back to close to cpu_pct, the way macOS's Activity Monitor
# does it, instead of top/htop's per-core-normalized convention where
# processes can individually read over 100%.
if (( totald > 0 )); then
  awk -F'\t' -v totald="$totald" '
    NR == FNR { t1[$1] = $3; next }
    {
      pid = $1; comm = $2; t2 = $3
      if (pid in t1) {
        d = t2 - t1[pid]
        if (d > 0) {
          printf "%d\t%s\n", d, comm
          sum += d
        }
      }
    }
    END { print "__SUM__\t" sum > "/dev/stderr" }
  ' "$sample_dir/p1" "$sample_dir/p2" 2> "$sample_dir/sum" \
    | sort -t $'\t' -k1,1rn > "$sample_dir/ranked"

  total_delta=$(awk -F'\t' '{print $2}' "$sample_dir/sum")
  head -n 3 "$sample_dir/ranked" | while IFS=$'\t' read -r delta comm; do
    awk -v d="$delta" -v c="$comm" -v t="$totald" 'BEGIN { printf "%s\t%.1f\n", c, (100*d/t) }'
  done
  top_delta=$(head -n 3 "$sample_dir/ranked" | awk -F'\t' '{s+=$1} END{print s+0}')
  other_delta=$(( total_delta - top_delta ))
  if (( other_delta > 0 )); then
    awk -v d="$other_delta" -v t="$totald" 'BEGIN { printf "__OTHER__\t%.1f\n", (100*d/t) }'
  fi
fi
