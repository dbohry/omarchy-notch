#!/bin/bash
# Output contract (see items/SysStats.qml):
# Line 1: "<cpu_pct> <mem_pct> <load1> <load5> <load15> <freq_mhz>
# <mem_total_kb> <mem_avail_kb> <swap_total_kb> <swap_free_kb>"
# Then up to 4 lines "<name>\t<pct>" (top CPU processes + one __OTHER__),
# a "---MEM---" separator, then the same shape for top RSS processes.

# comm in /proc/<pid>/stat can contain spaces/parens, so this splits on
# ")" and keeps the last piece -- always what follows comm.
proc_snapshot() {
  awk '
  {
    n = split($0, a, ")")
    rest = a[n]
    head = substr($0, 1, length($0) - length(rest) - 1)
    paren = index(head, "(")
    comm = substr(head, paren + 1)
    split(rest, f, " ")
    split(FILENAME, pp, "/")
    print pp[3] "\t" comm "\t" (f[12] + f[13] + 0)
  }' /proc/[0-9]*/stat 2>/dev/null
}

sample_dir=$(mktemp -d)
trap 'rm -rf "$sample_dir"' EXIT

proc_snapshot > "$sample_dir/p1"
read -r _ u1 n1 s1 i1 w1 irq1 sirq1 st1 _ < /proc/stat
sleep 0.3
read -r _ u2 n2 s2 i2 w2 irq2 sirq2 st2 _ < /proc/stat
proc_snapshot > "$sample_dir/p2"

idle1=$((i1 + w1))
idle2=$((i2 + w2))
total1=$((u1 + n1 + s1 + i1 + w1 + irq1 + sirq1 + st1))
total2=$((u2 + n2 + s2 + i2 + w2 + irq2 + sirq2 + st2))
totald=$((total2 - total1))
idled=$((idle2 - idle1))

cpu=0
if (( totald > 0 )); then
  cpu=$(( (100 * (totald - idled)) / totald ))
fi

mem_total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
mem_avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)
swap_total=$(awk '/^SwapTotal:/{print $2}' /proc/meminfo)
swap_free=$(awk '/^SwapFree:/{print $2}' /proc/meminfo)
mem=0
if (( mem_total > 0 )); then
  mem=$(( (100 * (mem_total - mem_avail)) / mem_total ))
fi

read -r load1 load5 load15 _ < /proc/loadavg

freq_khz=""
if [[ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq ]]; then
  freq_khz=$(< /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq)
fi
if [[ -n "$freq_khz" ]]; then
  freq_mhz=$(( freq_khz / 1000 ))
else
  # Some VMs/kernels have no cpufreq sysfs at all; /proc/cpuinfo's
  # "cpu MHz" is the fallback, less precise but always present.
  freq_mhz=$(awk '/^cpu MHz/{print int($4); exit}' /proc/cpuinfo)
fi

echo "$cpu $mem $load1 $load5 $load15 ${freq_mhz:-0} ${mem_total:-0} ${mem_avail:-0} ${swap_total:-0} ${swap_free:-0}"

# Normalized against totald (not a single core), so top3 + __OTHER__ sum
# close to cpu_pct -- unlike top/htop where a process can read over 100%.
if (( totald > 0 )); then
  awk -F'\t' '
    NR == FNR { t1[$1] = $3; next }
    {
      pid = $1; comm = $2; t2 = $3
      if (pid in t1) {
        d = t2 - t1[pid]
        if (d > 0) printf "%d\t%s\n", d, comm
      }
    }
  ' "$sample_dir/p1" "$sample_dir/p2" | sort -t $'\t' -k1,1rn > "$sample_dir/ranked"

  total_delta=$(awk -F'\t' '{s+=$1} END{print s+0}' "$sample_dir/ranked")
  top_delta=$(head -n 3 "$sample_dir/ranked" | awk -F'\t' '{s+=$1} END{print s+0}')
  head -n 3 "$sample_dir/ranked" | while IFS=$'\t' read -r delta comm; do
    awk -v d="$delta" -v c="$comm" -v t="$totald" 'BEGIN { printf "%s\t%.1f\n", c, (100*d/t) }'
  done
  other_delta=$(( total_delta - top_delta ))
  if (( other_delta > 0 )); then
    awk -v d="$other_delta" -v t="$totald" 'BEGIN { printf "__OTHER__\t%.1f\n", (100*d/t) }'
  fi
fi

echo "---MEM---"

mem_used_kb=$(( mem_total - mem_avail ))
awk '
  FNR == 1 { pid = ""; name = ""; rss = 0; split(FILENAME, pp, "/"); pid = pp[3] }
  /^Name:/  { name = $0; sub(/^Name:[ \t]*/, "", name) }
  /^VmRSS:/ { rss = $2 }
  ENDFILE { if (rss > 0) print pid "\t" name "\t" rss }
' /proc/[0-9]*/status 2>/dev/null | sort -t $'\t' -k3,3rn > "$sample_dir/mem_ranked"

if (( mem_used_kb > 0 )) && [[ -s "$sample_dir/mem_ranked" ]]; then
  total_rss=$(awk -F'\t' '{s+=$3} END{print s+0}' "$sample_dir/mem_ranked")
  if (( total_rss > 0 )); then
    top_rss=$(head -n 3 "$sample_dir/mem_ranked" | awk -F'\t' '{s+=$3} END{print s+0}')
    head -n 3 "$sample_dir/mem_ranked" | while IFS=$'\t' read -r pid name rss; do
      awk -v n="$name" -v r="$rss" -v t="$total_rss" -v u="$mem_used_kb" -v mt="$mem_total" \
        'BEGIN { printf "%s\t%.1f\n", n, (r/t)*(100*u/mt) }'
    done
    other_rss=$(( total_rss - top_rss ))
    if (( other_rss > 0 )); then
      awk -v r="$other_rss" -v t="$total_rss" -v u="$mem_used_kb" -v mt="$mem_total" \
        'BEGIN { printf "__OTHER__\t%.1f\n", (r/t)*(100*u/mt) }'
    fi
  fi
fi
